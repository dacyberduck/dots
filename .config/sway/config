### Input configuration
input "type:keyboard" {
    xkb_layout us
    xkb_numlock enable
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

### Output configuration
output eDP-1 resolution 1366x768@60Hz adaptive_sync on
output eDP-1 bg #3c3c3c solid_color

### Window rule
# general rules
for_window [shell = "xwayland"] floating enable
for_window [app_id = "xdg-desktop-portal-gtk"] floating enable
for_window [title="(?:Open|Save) (?:File|Folder|As)"] floating enable, resize set 800 600
for_window [window_type = "menu"] floating enable
for_window [window_role = "pop-up"] floating enable
for_window [window_role = "bubble"] floating enable
for_window [window_role = "dialog"] floating enable
for_window [window_role = "About"] floating enable
for_window [window_role = "task_dialog"] floating enable
for_window [window_role = "__scratchpad__"] border normal 1
for_window [window_role="Preferences"] floating enable
for_window [app_id = "floating"] floating enable
for_window [app_id = "floating_update"] floating enable, resize set width 1000 height 600
for_window [class = "(?i)pinentry"] floating enable
for_window [title="Picture-in-Picture"] floating enable, border none, sticky on
for_window [title = "Administrator privileges required"] floating enable
# Application Specific override
# <<< wps-office
for_window [class="et" instance="et"] floating disable
for_window [class="wpp" instance="wpp"] floating disable
for_window [class="wps" instance="wps"] floating disable
for_window [class="pdf" instance="pdf"] floating disable
for_window [class="prometheus" instance="prometheus"] floating disable
for_window [class="et" instance="et" title="et"] floating enable
for_window [class="wpp" instance="wpp" title="wpp"] floating enable
for_window [class="wps" instance="wps" title="wps"] floating enable
for_window [class="pdf" instance="pdf" title="pdf"] floating enable
for_window [class="prometheus" instance="prometheus" title="prometheus"] floating enable
# >>>
for_window [app_id="mpv"] floating enable
for_window [app_id="qalculate-gtk"] floating enable
for_window [app_id="^blueman-*"] floating enable
for_window [app_id="org.twosheds.iwgtk"] floating enable
for_window [app_id="librewolf" title="Library"] floating enable
for_window [class="^steam$"] floating enable, move container to workspace number 9
for_window [title="^Krita$"] floating disable
for_window [class="modorganizer.exe"] floating disable


### Compositor configuration
font Dina NFM 12
focus_follows_mouse yes
default_border pixel 2
default_floating_border normal 1
smart_borders off
gaps inner 4
gaps outer 0
smart_gaps off
show_marks yes

### Variables
# Logo key. Use Mod1 for Alt.
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
#set $menu tofi-drun --horizontal true --anchor top --width 1366 --height 20 | xargs swaymsg exec --
set $menu tofi-drun --horizontal true --anchor top --width 1366 --height 20 --drun-launch true

### Idle configuration
exec swayidle -w \
         lock 'swaylock -f -c 1c1c1c -e' \
         before-sleep 'loginctl lock-session' \
         timeout 60  'xbacklight -store; xbacklight -steps 300 -set 10' resume 'xbacklight -steps 300 -restore' \
         timeout 300 'loginctl lock-session' resume 'echo "session locked"' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         timeout 1800 'systemctl suspend-then-hibernate'

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu
bindsym --no-repeat $mod+Tab exec ~/.config/sway/sway-window-switcher.py -t all
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Ctrl+l exec loginctl lock-session

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# workspace back forth
bindsym Mod1+tab workspace back_and_forth

# mark/unmark
bindsym $mod+m exec swaymsg "mark --toggle $(: | tofi --require-match=false --horizontal=true --height=20 --anchor=top --width=100% --prompt-text='mark: ')"

# Switch the split direction of the current container
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+n split none

# Switch the current container between different layout styles
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# Move focus to the parent container
bindsym $mod+a focus parent

# Move focus to the parent container
bindsym $mod+Shift+a focus child

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

# Resizing containers:
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Special keybindings
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec xbacklight -dec 5
bindsym --locked XF86MonBrightnessUp exec xbacklight -inc 5
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --no-repeat Print exec pgrep slurp && pkill slurp || (grim -g "$(slurp)" /tmp/screenshot.png && wl-copy -t image/png < /tmp/screenshot.png && swayimg /tmp/screenshot.png)

# gestures
bindgesture swipe:3:up focus up
bindgesture swipe:3:down focus down
bindgesture swipe:3:left focus left
bindgesture swipe:3:right focus right
bindgesture swipe:4:right workspace next
bindgesture swipe:4:left workspace prev
bindgesture swipe:4:up focus parent
bindgesture swipe:4:down focus child
bindgesture hold:3 splitt
bindgesture hold:4 split none


exec --no-startup-id dbus-update-activation-environment --systemd --all
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
# sway scripts
exec --no-startup-id /home/duck/.config/sway/dynamic-titlebar.sh


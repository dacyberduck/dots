#!/bin/bash

function print_bluetooth_info() {
  local powered connected device
  powered="$(busctl get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2>/dev/null | awk '{print $2}')"
  connected='false'
  device="$(bluetoothctl info | grep Name | awk -F 'Name: ' '{print $2}'| xargs)"
  if [[ x${device}x != xx ]]; then
    connected='true'
  fi
  echo "{\"powered\": ${powered}, \"device\": \"${device}\", \"connected\": ${connected}}"
}

print_bluetooth_info
dbus-monitor --system "type='signal',path='/org/bluez/hci0',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" "type='signal',path='/org/bluez/hci0/dev_A4_05_6E_59_43_04',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" 2>/dev/null |
  while read -r event; do
    print_bluetooth_info
  done

# vim: et sts=2 sw=2:

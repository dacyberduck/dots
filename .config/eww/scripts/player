#!/bin/bash

function print_player_info() {
    if [[ -z ${1} ]]; then
      echo '{"player": "","title":"","artist":"","album":"","status":"stopped"}'
    else
      echo "${1}"
    fi
}

#print_player_info
playerctl --follow --player=mpv metadata --format "{\"player\":\"{{playerName}}\",\"title\":\"{{markup_escape(title)}}\",\"album\":\"{{markup_escape(album)}}\",\"artist\":\"{{markup_escape(artist)}}\",\"status\":\"{{lc(status)}}\"}" 2>/dev/null |
  while read -r event; do
    print_player_info "${event}"
  done

# vim: set et sts=2 sw=2:

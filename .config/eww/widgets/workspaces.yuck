; vim: et sts=3 sw=3:
(deflisten __nwsp "~/Scripts/eww/watchers/niri-workspaces")
(deflisten __swsp  :initial "${[1]}" "~/Scripts/eww/watchers/sway-workspaces")
(deflisten __smode "swaymsg -t subscribe '[\"mode\"]' --monitor")

(defwidget _niriWorkspaces []
   (box
      :class "workspaces"
      :orientation "h"
      :space-evenly false
      (box
         :orientation "h"
         :space-evenly false
         (for entry in __nwsp
            (button
               :onclick "niri msg action focus-workspace ${entry.idx}"
               :class {entry.is_focused ? "focused" : entry.is_urgent ? "urgent" : "normal" }
               "${entry.idx}"
            )
         )
      )
   )
)

(defwidget _swayWorkspaces []
   (box
      :class "workspaces"
      :orientation "h"
      :space-evenly false
      (box
         :orientation "h"
         :space-evenly false
         (for entry in __swsp
            (button
               :onclick "swaymsg workspace \"${entry.name}\""
               :class {entry.focused ? "focused" : entry.urgent ? "urgent" : "normal" }
               "${entry.name}"
            )
         )
      )
   )
)

(defwidget _swayMode []
   (box
      :class "sway_mode"
      :orientation "h"
      :space-evenly false
      (label :text {__smode.change == "default" ? "" : "[${__smode.change}]"})
   )
)

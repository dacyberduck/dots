; vim: set et sts=3 sw=3:
(deflisten __vol './scripts/volume')

(defwidget _volume []
   (eventbox
      :class "volume"
      :onscroll "[[ {} == up ]] && wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ || wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
      :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      :onrightclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
      (circular-progress
         :class {__vol.sink.mute ? "mute" : "volume"}
         :value {round(__vol.sink.vol * 100, 0)}
         :thickness 4
         :start-at 75
         :clockwise true
         :tooltip "󰓃 ${__vol.sink.name}, ${round(__vol.sink.vol * 100, 0)}%${__vol.sink.mute ? ' [MUTE]' : ''}
 ${__vol.source.name}, ${round(__vol.source.vol * 100, 0)}%${__vol.source.mute ? ' [MUTE]' : ''}"
         ""
      )
   )
)

; vim: et sts=3 sw=3:
(defvar    __rev_backlight false)
(deflisten __brt 'xbacklight -subscribe')
(defpoll   __gamma_on :interval "999999s" "pgrep gammastep >/dev/null && echo 1 || echo 0")
(defpoll   __idleblocked :interval "999999s" "[[ -f ~/.cache/_idleblocked ]] && echo 1 || echo 0")

(defwidget _brightness []
   (eventbox
      :class "brightness"
      :onscroll "[[ {} == up ]] && xbacklight -inc 1 || xbacklight -dec 1"
      (circular-progress
         :value {round(__brt, 0)}
         :thickness 4
         :start-at 75
         :clockwise true
         :tooltip "󰃝 intel_backlight, ${round(__brt, 0)}"
         ""
      )
   )
)

(defwidget _gamma []
   (button
      :class {__gamma_on == '1' ? 'enabled' : 'disabled'}
      :onclick '(pgrep gammastep >/dev/null 2>&1) && (pkill -9 gammastep) || (gammastep -O 3600 >/dev/null 2>&1 &); ${EWW_CMD} poll __gamma_on'
      :onrightclick '(pgrep gammastep >/dev/null 2>&1) && (pkill -9 gammastep) || (gammastep -b 1.0:0.75 -l 22.56:88.33 -t 6500:3600 >/dev/null 2>&1 &); ${EWW_CMD} poll __gamma_on'
      :tooltip "Night Light: ${__gamma_on == '1' ? 'ON' : 'OFF'}"
      (label
         :text "󰖔"
      )
   )
)

(defwidget _idle_inhibitor []
   (button
      :class {__idleblocked == '1' ? 'enabled' : 'disabled'}
      :tooltip "Idle Inhibitor: ${__idleblocked == '1' ? 'ON' : 'OFF'}"
      :onclick {__idleblocked == '1' ? 'swaymsg inhibit_idle none; rm -f $HOME/.cache/_idleblocked; ${EWW_CMD} poll __idleblocked' : 'swaymsg inhibit_idle open; touch $HOME/.cache/_idleblocked; ${EWW_CMD} poll __idleblocked'}
      "󰈈"
   )
)

(defwidget _backlight []
   (eventbox
      :onhover "${EWW_CMD} update __rev_backlight=true"
      :onhoverlost "${EWW_CMD} update __rev_backlight=false"
      (box
         :class "backlight"
         :space-evenly false
         :halign "end"
         :hexpand false
         (revealer
            :reveal __rev_backlight
            :transition "slideleft"
            (box
               (_idle_inhibitor)
               (_gamma)
            )
         )
         (_brightness)
      )
   )
)

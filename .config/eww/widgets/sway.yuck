; vim: et sts=3 sw=3:
(deflisten __swsp  :initial "${[1]}" "./scripts/sway_workspaces")
(deflisten __smode "swaymsg -t subscribe '[\"mode\"]' --monitor")
; (deflisten __swin  "swaymsg -t subscribe '[\"window\"]' --monitor")

(defwidget _swayWorkspaces []
   (box
      :class "sway_workspaces"
      :orientation "h"
      :space-evenly false
      (box
         :orientation "h"
         :space-evenly false
         (for entry in __swsp
            (button
               :onclick "swaymsg workspace \"${entry.name}\""
               :class {entry.focused ? "focused" : entry.urgent ? "urgent" : "normal" }
               "${entry.name}"
            )
         )
      )
   )
)

(defwidget _swayMode []
   (box
      :class "sway_mode"
      :orientation "h"
      :space-evenly false
      (label :text {__smode.change == "default" ? "" : "[${__smode.change}]"})
   )
)


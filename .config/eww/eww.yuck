; vim: set et sts=3 sw=3:

(include './widgets/sway.yuck')
(include './widgets/tray.yuck')
(include './widgets/clock.yuck')
(include './widgets/power.yuck')
(include './widgets/sound.yuck')
(include './widgets/network.yuck')
(include './widgets/backlight.yuck')
(include './widgets/notification.yuck')

(defvar __rev1 false)

(defwidget statusbar []
   (centerbox
      :class "statusbar"
      :orientation "h"
      (box
         :class "start"
         :orientation "h"
         :space-evenly false
         :halign "start"
         :spacing 6
         (_swayWorkspaces)
         (_swayMode)
      )
      (box
         :class "center"
         :orientation "h"
         :space-evenly false
         :halign "center"
         :spacing 6
         ; (_swayWindow)
      )
      (box
         :class "end"
         :orientation "h"
         :space-evenly false
         :halign "end"
         :spacing 6
         (_playerctl)
         (_notification)
         (_network)
         (_volume)
         (_backlight)
         (_power)
         (_clock)
         (_tray)
      )
   )
)

(defwindow statusbar
   :monitor 0
   :geometry (geometry
      :x "0%"
      :y "0%"
      :width "100%"
      :height "20px"
      :anchor "top center"
   )
   :stacking "fg"
   :wm-ignore false
   :exclusive true
   :namespace "statusbar"
   (statusbar)
)

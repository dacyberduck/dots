(include './widgets/clock.yuck')
(include './widgets/volume.yuck')
(include './widgets/battery.yuck')
(include './widgets/backlight.yuck')


(defwidget statusbar []
   (centerbox
      :class "statusbar"
      :orientation "h"
      (box
         :class "start"
         :orientation "h"
         :space-evenly false
         :halign "start"
         :spacing 6
      )
      (box
         :class "center"
         :orientation "h"
         :space-evenly false
         :halign "center"
         :spacing 6
      )
      (box
         :class "end"
         :orientation "h"
         :space-evenly false
         :halign "end"
         :spacing 6
         (_volume)
         (_backlight)
         (_battery)
         (_clock)
      )
   )
)

(defwindow statusbar
   :monitor 0
   :geometry (geometry
      :x "0%"
      :y "0%"
      :width "100%"
      :height "20px"
      :anchor "top center"
   )
   :stacking "fg"
   :wm-ignore false
   :exclusive true
   :namespace "statusbar"
   (statusbar)
)

; vim: set et sts=3 sw=3:

// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1773043788989835020 @name=mpv
window-rule {
    match app-id="^mpv$"
    open-floating true
}

// @id=wr_1773043971152628915 @name=firefox-bin
window-rule {
    match app-id="^firefox-bin$" title="About Mozilla Firefox"
    open-floating true
}

// @id=wr_1773764927176598473 @name=firefox-bin
window-rule {
    match app-id="^firefox-bin$" title="Library"
    open-floating true
}

// @id=wr_1773197870490593250 @name=polkit
window-rule {
    match title="Administrator privileges required"
    open-floating true
}

// @id=wr_1773197906561641335 @name=swayimg
window-rule {
    match app-id="^swayimg$"
    open-floating true
}

// @id=wr_1773197955712606389 @name=pinentry
window-rule {
    match app-id="(?i)pinentry"
    open-floating true
}

// @id=wr_1773197826848370301 @name=File Open/Save
window-rule {
    match title="(?:Open|Save) (?:File|Folder|As)"
    open-floating true
}

// @id=wr_1773198389181502076 @name=Picture-in-picture
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}

// @id=wr_1773660372415123288 @name=steam_app_0
window-rule {
    match app-id="^steam_app_0$"
    open-floating true
}

// @id=wr_1773846975102673784 @name=org.qbittorrent.qBittorrent
window-rule {
    match app-id="^org.qbittorrent.qBittorrent$"
    open-floating true
}

// @id=wr_1774033181990411690 @name=zenity
window-rule {
    match app-id="^zenity$"
    open-floating true
}

// @id=wr_1774767276167013779 @name=org.qbittorrent.qBittorrent
window-rule {
    match app-id="^org.qbittorrent.qBittorrent$" title="^qBittorrent"
    clip-to-geometry true
    tiled-state true
}

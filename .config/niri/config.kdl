// vim: set et sts=4 sw=4:

// Output device confguration
output "eDP-1" {
    mode "1366x768@60.003"
    scale 1
    position x=0 y=0
    focus-at-startup
    hot-corners {
        off
    }
}

// Input device configuration.
input {
    // xkeyboard settings.
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    // libinput settings.
    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// disable hot-key overlay on niri start
hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// window switcher
recent-windows {
    highlight {
        corner-radius 0
        active-color   "#458588"
        urgent-color   "#cc241d"
    }
}

// layout
layout {
    gaps 4

    background-color "transparent"

    focus-ring {
        width 0
    }

    border {
        width 1
        active-color   "#83a598"
        inactive-color "#3c3c3c"
        urgent-color   "#cc241d"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#83a598"
        inactive-color "#ebdbb2"
        urgent-color   "#cc241d"
    }

    insert-hint {
        color "#83a59880"
    }

    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6667
        proportion 1.0
    }
}

// envvars
environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
}

include "cfg/autostart.kdl"
include "cfg/binds.kdl"
include "cfg/window-rules.kdl"

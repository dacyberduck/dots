# MRU complete
def MruComplete(_, _, _): string
  return v:oldfiles->join("\n")
enddef
command! -nargs=+ -complete=custom,MruComplete MRU edit <args>

# Scratch term: opens terminal and runs command received as arguments
# USAGE Example:
#   :ScratchTerm make %<
#   :ScratchTerm bash -c %:p
def ScratchTerm(...args: list<any>): void
  const termbufname = "__SCRATCH_TERM__"
  var scratch_bufnr = -1
  var cmd = args->join()->expandcmd()
  for buf in tabpagebuflist()
    if buf->bufname() == termbufname
      scratch_bufnr = buf
    endif
  endfor
  # scratch term not exists
  if scratch_bufnr == -1
    term_start('bash', {'term_name': termbufname, 'term_finish': 'close', 'term_rows': 15})
    if len(cmd) > 0
      sleep 100m
      term_sendkeys(bufnr(), cmd .. "\<CR>")
      wincmd p
    endif
  else
    # delete scratch term if it is focused
    if win_getid() == bufwinid(scratch_bufnr)
      execute "silent bdelete! " .. scratch_bufnr
    # focus on scratch term if not focused
    else
      scratch_bufnr->bufwinid()->win_gotoid()
    endif
  endif
enddef
command! -nargs=* -complete=shellcmd ScratchTerm ScratchTerm(<q-args>)

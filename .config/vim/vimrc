vim9script
################################################################################
# __   _____ __  __ ___  ___
# \ \ / /_ _|  \/  | _ \/ __|
#  \ V / | || |\/| |   / (__
#   \_/ |___|_|  |_|_|_\\___|
#
################################################################################
# <<< options/settings
set viminfofile=$XDG_CONFIG_HOME/vim/viminfo
set nobackup
set swapfile directory=$XDG_CACHE_HOME/
set undofile undolevels=1000 undodir=$XDG_CACHE_HOME/
set viewdir=$XDG_CACHE_HOME/
################################################################################
&t_SI = "\<Esc>[6 q"
&t_SR = "\<Esc>[4 q"
&t_EI = "\<Esc>[2 q"
&t_TI = "\<Esc>[>4;2m"
&t_TE = "\<Esc>[>4;m"
&t_8f = "\e[38;2;%lu;%lu;%lum"
&t_8b = "\e[48;2;%lu;%lu;%lum"
set history=1000
set nocompatible
set showcmd
set autoread
set noconfirm
set novisualbell noerrorbells
set modeline
set mouse=ni mousemodel=popup_setpos
set path+=**
set tags+=.tags
set nospell spelllang=en spellsuggest=best,9
set dictionary=/usr/share/dict/words
set encoding=utf-8
set ttyfast
set title
set ttimeoutlen=0
set clipboard=unnamedplus
set backspace=indent,eol,start virtualedit=block,insert
set tabpagemax=50
set shell=/bin/bash
set nolangremap
filetype plugin indent on
set guifont=Fira\ Code\ 9
set guioptions-=T guioptions+=k
set cursorline nocursorcolumn
set number norelativenumber
set nowrap wrapmargin=0 textwidth=0 colorcolumn=81
set scrolloff=5 sidescrolloff=5
set formatoptions-=ot formatoptions+=n
set ruler
set nolist listchars=nbsp:␣,extends:…,trail:·
set fillchars=vert:│,fold:─
set foldenable foldmethod=marker foldmarker=<<<,>>> foldlevel=0
set conceallevel=3
set wildmode=noselect:lastused,full
set wildmenu wildoptions=pum
set wildignore=*/.git/*,.config/*,.cargo/*,.mozilla/*,.local/*,*/.cache/*
set wildignore+=*/Games/*,*.exe,*.dll,*.class,*.psd,*.zip,*.rar,*.tar.gz
set wildignore+=*.tar.bz2,*.tar.xz,*.swp,*.o,*.obj,*.bak,*.pyc,__pycache__
set wildignore+=.DS_Store,Thumbs.db,*/viminfo,*/vifminfo
set wildcharm=<C-Z>
set nrformats-=octal
set nosplitright splitbelow
set shortmess-=S shortmess+=cC
set completepopup=highlight:Pmenu
set completeopt=popup,fuzzy
set autocomplete
set completefuzzycollect=keyword
set complete=.^7,w^5,b^5,u^3,t^3,i^3
set pumheight=10
set magic hlsearch incsearch
set ignorecase smartcase
set smarttab autoindent smartindent
if &diff
  set cursorbind scrollbind
else
  set nocursorbind noscrollbind
endif
# >>>
################################################################################
# <<< statusline
set laststatus=2
set statusline=
set statusline+=%<[%n]\ %f%m%h%w
set statusline+=%=
set statusline+=[%l,\ %c%V]
# >>>
################################################################################
# <<< colorscheme
if !has('gui_running') && &term =~ '^\%(screen\|tmux\)'
  &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
  &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
endif

syntax on
set termguicolors
set background=dark
colorscheme retrobox
hi Comment guifg=#928374 guibg=NONE gui=NONE cterm=italic
hi SpecialComment guifg=#fb4934 guibg=NONE gui=NONE cterm=italic
highlight ColorColumn ctermbg=magenta
# >>>
################################################################################
# <<< commands
# sort words
command! -nargs=0 -range Sort :<line1>,<line2>call setline('.',
      \ join(sort(split(getline('.'), ' ')), ' '))
# open quickfixlist after grep
command! -nargs=+ -complete=file Grep execute 'silent grep! <args>' | cwindow
      \| redraw!
# MRU complete
def MruComplete(_, _, _): list<string>
  return v:oldfiles
enddef
command! -nargs=+ -complete=customlist,MruComplete MRU edit <args>
# >>>
################################################################################
# <<< autocommands
autocmd CmdlineChanged : call wildtrigger()
autocmd FileType help,qf,git,lspgfm nnoremap <buffer> q <cmd>close<cr>
autocmd FileType c,cpp,cs,objc,csproj,python,qml setlocal et ts=4 sts=4 sw=4
autocmd FileType bash,lua setlocal et sts=3 sw=3
autocmd FileType xml setlocal noet ts=8 sts=8 sw=8
autocmd FileType gitsendemail setlocal noet ts=4 sts=4 sw=4
autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$")
      \| execute "normal! g`\"" | endif
autocmd BufWritePost $MYVIMRC source $MYVIMRC | windo redraw
      \| echomsg "Successfully reloaded $MYVIMRC"
# >>>
################################################################################
# <<< mappings
g:mapleader = " "
xnoremap <silent> < <gv
xnoremap <silent> > >gv
nnoremap <silent> <C-L> :nohlsearch<CR><C-L>
cnoremap <expr> <Left> pumvisible() ? "\<C-Y>" : "\<Left>"
nnoremap <silent><ESC> <ESC>:noh<CR><ESC>
nnoremap <silent> ]q :cnext<CR>
nnoremap <silent> [q :cprev<CR>
nnoremap <silent><expr> gb ":\<C-U>" .. (v:count == 0 ? "bnext!\<CR>" :
      \ (bufexists(v:count) ? $"buffer! {v:count}\<CR>" :
      \ $"echoerr 'Buffer {v:count} does not exist'\<CR>"))
nnoremap <silent><expr> gB ":\<C-U>" .. (v:count == 0 ? "bprevious!\<CR>" :
      \ $"{v:count}bprevious!\<CR>")
cnoremap <C-Up> <C-U><Up>
cnoremap <C-Down> <C-U><Down>
# >>>
################################################################################
# <<< plugins
### netrw
g:netrw_home        = "$XDG_CACHE_HOME/" # move netrw history to cache directory
g:netrw_banner      = v:false
g:netrw_bufsettings = "noma nomod nu nobl nowrap ro nornu"

### vim built-in plugins
packadd cfilter
packadd comment
packadd justify
packadd matchit
# >>>
################################################################################
defcompile
# vim: set et sts=2 sw=2:

# simple auto pair plugin
def SimpleAutoPair(open: string, close: string): string
  const line = getline('.')
  const colm = col('.') - 1 # string index starts from 0
  if line[colm] !~ '\s' && (stridx(line, close, colm) != -1 || colm < col('$') - 1)
    return open
  else
    return open .. close .. "\<left>"
  endif
enddef
inoremap <expr> " <SID>SimpleAutoPair('"', '"')
inoremap <expr> ' <SID>SimpleAutoPair("'", "'")
inoremap <expr> ( <SID>SimpleAutoPair("(", ")")
inoremap <expr> { <SID>SimpleAutoPair("{", "}")
inoremap <expr> [ <SID>SimpleAutoPair("[", "]")

# simple indent guide
def g:IndentGuide()
  const bufnr = bufnr()
  if getbufvar(bufnr, '&buflisted') && getbufvar(bufnr, '&modifiable')
    exec 'setlocal listchars=' ..
      join(filter(split(&listchars, ","), 'v:val !~ "leadmultispace" && v:val !~ "tab"') +
      ['leadmultispace:│' .. repeat('\ ', &shiftwidth - 1), 'tab:█\ '],
      ",")
    setlocal list
  endif
enddef
augroup IndentGuide
  au!
  autocmd BufWinEnter * call IndentGuide()
augroup END

# toggle between qflist & loclist
def ToggleQuickFixLocList()
  const tabn = tabpagenr()
  const qvis = !empty(filter(getwininfo(), $'v:val.tabnr == {tabn} && v:val.quickfix && !v:val.loclist'))
  const lvis = !empty(filter(getwininfo(), $'v:val.tabnr == {tabn} && v:val.quickfix && v:val.loclist'))
  const qwin = (qvis) ? map(filter(getwininfo(), $'v:val.tabnr == {tabn} && v:val.quickfix && !v:val.loclist'), 'v:val.winnr')[0] : -1
  const lwin = (lvis) ? map(filter(getwininfo(), $'v:val.tabnr == {tabn} && v:val.quickfix && v:val.loclist'), 'v:val.winnr')[0] : -1
  const cwin = winnr()
  if (qvis) && (lvis)
    if (cwin == qwin)
      execute $":{lwin}wincmd q"
    elseif (cwin == lwin)
      execute $":{qwin}wincmd q"
    else
      execute $":{qwin}wincmd w"
      execute $":{lwin}wincmd q"
    endif
  elseif (qvis)
    if (cwin == qwin)
      execute $":{qwin}wincmd q"
      silent! lopen
    else
      execute $":{qwin}wincmd w"
    endif
  elseif (lvis)
    if (cwin == lwin)
      execute $":{lwin}wincmd q"
      silent! copen
    else
      execute $":{lwin}wincmd w"
    endif
  else
    silent! copen
  endif
enddef
nnoremap <silent> <leader>l :call <SID>ToggleQuickFixLocList()<CR>

# wayland system clipboard
# shamelessly copied from vim-wayland-clipboard plugin
def WaylandYank()
  if v:event['regname'] == '+'
    silent call job_start(['wl-copy', '--', getreg(v:event['regname'])], {
          \   "in_io": "null", "out_io": "null", "err_io": "null",
          \   "stoponexit": "",
          \ })
  endif
enddef
augroup WaylandYank
  au!
  autocmd TextYankPost * call WaylandYank()
augroup END
# remap paste commands to first pull in clipboard contents with wl-paste
var prepaste = "silent let @\"=substitute(system('wl-paste --no-newline'), \"\\r\", '', 'g')"
for p in ['p', 'P']
  execute "nnoremap <silent> \"+" .. p .. " :<C-U>" .. prepaste .. " \\| exec 'normal! ' . v:count1 . '" .. p .. "'<CR>"
endfor
for cr in ['<C-R>', '<C-R><C-R>', '<C-R><C-O>', '<C-R><C-P>']
  execute "inoremap <silent> " .. cr .. "+ <C-O>:<C-U>" .. prepaste .. "<CR>" .. cr .. "\""
endfor

# easy buffer switching
def JumpToBuffer(bufnr: number, rev: bool = v:false)
  if rev
    exec $":{bufnr == 0 ? 1 : bufnr}bprevious!"
  else
    if bufnr == 0
      bnext!
    else
      if bufnr->bufexists()
        exec $'buffer! {bufnr}'
      endif
    endif
  endif
enddef
nnoremap <silent> gb :<C-U>call <SID>JumpToBuffer(v:count)<CR>
nnoremap <silent> gB :<C-U>call <SID>JumpToBuffer(v:count, v:true)<CR>

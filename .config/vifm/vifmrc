" vim: filetype=vifm et sts=3 sw=3:

" options
" =========================================================
set autochpos
set confirm=permdelete
set dotdirs=
set fastrun
set fillchars=
set followlinks
set history=100
set hlsearch
set iec
set ignorecase
set incsearch
set iooptions=datasync,fastfilecloning
set laststatus
set mouse=a
set number
set norelativenumber
set rulerformat=
set norunexec
set scrolloff=5
set previewoptions+=hardgraphicsclear
set sessionoptions=bookmarks,registers,savedirs,state,chistory,dhistory,ehistory,mchistory,shistory
set shortmess=pLMT
set smartcase
set sortnumbers
set sortorder=ascending
set statusline="  %z%= %A %g %d %s  %l/%S [%L]"
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers
set syscalls
set tablabel=%[(%n)%]%[%[%T{tree}%]%[{%c}%]@%]%p:t
set timefmt='%Y/%m/%d %H:%M'
set trash
set trashdir="~/.local/share/Trash/vifm"
set title
set undolevels=100
set vicmd=vim
set vifminfo=bookmarks,registers,savedirs,state,chistory,dhistory,ehistory,mchistory,shistory
set vimhelp
set wildmenu
set wildstyle=popup
set nowrap

" colorscheme
" =========================================================
colorscheme retrobox

" marks
" =========================================================
mark h ~/
mark c ~/.config
mark C ~/.config/vifm
mark m ~/Music
mark d ~/Downloads
mark D ~/Documents
mark V ~/.config/vim
mark p ~/Pictures
mark b ~/.local/bin

" commands
" =========================================================
command! Q     :qall
command! df    df -h %m 2>/dev/null
command! editX vim -O %c %C
command! diff  vim -d %c %C
command! Gdiff git diff %c %m 2>/dev/null
command! GDiff git diff %d %m 2>/dev/null
command! make  !!make %a
command! mkcd  :mkdir %a | cd %a
command! Vconf :write | execute ':!%n${EDITOR:-vim} $MYVIFMRC' | restart full

" keybindings
" ==========================================================
""" Cursor to most recently modified non-directory file
nnoremap <silent> gn :<C-U>exe 'goto' fnameescape(system('ls -Atp ' . expand('%d') . ' | grep -vm' . v:count1 . ' / | tail -n 1'))<CR>
""" Cursor to least recently modified non-directory file
nnoremap <silent> gN :<C-U>exe 'goto' fnameescape(system('ls -Artp ' . expand('%d') . ' | grep -vm' . v:count1 . ' / | tail -n 1'))<CR>
""" yank current directory path/file path/file name into clipboard
nnoremap yF :!echo -n %d   | wl-copy %i<cr>:echo expand('%"d') "is yanked to clipboard"<cr>
nnoremap yf :!echo -n %c:p | wl-copy %i<cr>:echo expand('%"c:p') "is yanked to clipboard"<cr>
""" drag and drop using dragon
nnoremap yd :!dragon -a -x -T %f %i<CR>
""" copy/move file to other pane
nnoremap gy :copy<cr>
nnoremap gY :move<cr>
vnoremap gy :copy<cr>
vnoremap gY :move<cr>
""" fold
nnoremap zc zm
""" shellout
nnoremap <silent> S :shell<cr>
""" sort
nnoremap <silent> <c-s> :sort<CR>
""" make sure history binds are working
nnoremap <c-o> :histprev<cr>
nnoremap <c-i> :histnext<cr>
""" toggle visibility of preview window
nnoremap <silent> <S-Tab> :view<CR>
vnoremap <silent> <S-Tab> :view<cr>gv
""" moving cursor on the other pane
nnoremap <silent> J <space>j<space>
nnoremap <silent> K <space>k<space>
""" moving though sibling directories
nnoremap <c-j> ]R
nnoremap <c-k> [R
""" spawn new terminal
nnoremap <c-t> :!$TERMINAL %i<CR>
""" tmux navigation
nnoremap <silent> <c-h> :if paneisat('left')   | execute '!tmux select-pane -L %i' | else | execute 'wincmd h' | endif<cr>
nnoremap <silent> <c-j> :if paneisat('bottom') | execute '!tmux select-pane -D %i' | else | execute 'wincmd j' | endif<cr>
nnoremap <silent> <c-k> :if paneisat('top')    | execute '!tmux select-pane -U %i' | else | execute 'wincmd k' | endif<cr>
nnoremap <silent> <c-l> :if paneisat('right')  | execute '!tmux select-pane -R %i' | else | execute 'wincmd l' | endif<cr>
" account for <c-h>/<bs> conflict
nnoremap <silent> <bs>  :if paneisat('left')   | execute '!tmux select-pane -L %i' | else | execute 'wincmd h' | endif<cr>
""" resize window
nnoremap - <C-w>5<
nnoremap _ <C-w>5>

""""""""""""""""""""""""""
" Plugins

""""""""""""""""""""""""""
filextype {*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm},<image/*>
        \ {View in swayimg}
        \ swayimg %f,

filetype {*.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,
         \*.opus,*.aac,*.mpga},<audio/*>
       \ {Play using mpv}
       \ playerctl --player=mpv stop; mpv --no-video %f %s %i,
       \ {Play using ffplay}
       \ ffplay -nodisp -hide_banner -autoexit %c %i,

filextype {*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,
          \*.fl[icv],*.m2v,*.mov,*.webm,*.mts,*.m4v,*.r[am],*.qt,*.divx,
          \*.as[fx],*.unknown_video},<video/*>
        \ {Play using mpv}
        \ playerctl --player=mpv stop; mpv --save-position-on-quit %f %i,
        \ {View using ffplay}
        \ ffplay -fs -hide_banner -autoexit %f %i,

filextype *.pdf
        \ {Open using browser}
        \ $BROWSER %f %i,

filextype *.dds
        \ {Open using gimp}
        \ gimp %f %i,

""""""""""""""""""""""""""""""""
" Others

""""""""""""""""""""""""""""""""

" Show nested instance in statusline
let $VIFM_OPENED = $VIFM_OPENED+1
if $VIFM_OPENED > 1
    set statusline="  Warning: You are opening vifm inside vifm!"
else
    set statusline="  %z%= %A %g %d %s  %l/%S [%L]"
endif

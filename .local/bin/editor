#!/bin/bash

# smart open files in vim
#  -> when in terminal use vim;
#  -> when in gui, use gvim.

TERM_EXEC="foot -- "

# 1. Terminal/TUI Check
if [ -t 1 ]; then
  # Open in terminal Vim (fresh instance for git/vifm/nnn)
  vim -p "$@"
else
  # 2. GUI/Niri Logic
  SERVER_NAME="__GVIM__"

    # Check if gVim server is running
    if gvim --serverlist | grep -qi "$SERVER_NAME"; then
      # Send file to existing gVim instance
      gvim --servername "$SERVER_NAME" --remote-tab-silent "$@"

        # 3. Autofocus for Niri
        # Find the window ID for gVim using niri msg
        # Note: gVim usually has app_id "org.vim.Gvim" or "gvim"
        GVIM_ID=$(niri msg --json windows | jq -r '.[] | select(.app_id | test("gvim"; "i")) | .id' | head -n 1)

        if [ -n "$GVIM_ID" ] && [ "$GVIM_ID" != "null" ]; then
          niri msg action focus-window --id "$GVIM_ID"
        fi
      else
        # Start new gVim server instance
        # TODO: remove x11 when vim wayland support is released
        GDK_BACKEND=x11 gvim --servername "$SERVER_NAME" -p "$@"
    fi
fi

# vim: set et sts=2 sw=2:
